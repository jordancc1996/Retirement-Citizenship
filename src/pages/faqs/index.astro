---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/seo/PageHead.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import Breadcrumbs from '../../components/seo/Breadcrumbs';
import InternalLinks from '../../components/seo/InternalLinks';
import UniversalContactForm from '../../components/UniversalContactForm';
import { generateFAQSchema } from '../../lib/seo/structured-data';
import { assetUrl } from '../../lib/assetUrl';
import { getCollection } from 'astro:content';
import faqsHero from '../../assets/faqs-hero.jpg';

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);

const faqStructuredData = generateFAQSchema(
  faqs.slice(0, 10).map((faq) => ({
    question: faq.data.question,
    answer: faq.body.replace(/^#+\s+/gm, '').substring(0, 200) + '...',
  }))
);
---
<Layout>
  <Fragment slot="head">
    <PageHead
      title="FAQs | Your Questions Answered"
      description="Frequently asked questions about retiring abroad, golden visas, citizenship programs, healthcare, and cost of living for American retirees moving overseas."
      canonical="/faqs"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header variant="hero" client:load />

    <section
      class="relative min-h-[70vh] flex items-center justify-center bg-cover bg-center bg-no-repeat"
      style={`background-image: url(${assetUrl(faqsHero)})`}
    >
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute top-20 left-0 right-0 z-10">
        <div class="container mx-auto px-8">
          <Breadcrumbs items={[{ name: 'FAQs', url: '/faqs' }]} variant="hero" client:load />
        </div>
      </div>
      <div class="container mx-auto px-8 max-w-4xl text-center relative z-10">
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-light mb-6 text-white">
          Frequently Asked Questions
        </h1>
        <p class="font-sans text-lg md:text-xl text-white/90 leading-relaxed max-w-3xl mx-auto">
          Expert answers to your most pressing questions on citizenship by investment, Golden Visa eligibility, and the complexities of international relocation
        </p>
      </div>
    </section>

    <section class="py-20 bg-background">
      <div class="container mx-auto px-8 max-w-4xl">
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <a
              href={`/faqs/${faq.slug}`}
              class="block border border-primary/20 px-6 py-5 hover:bg-secondary/20 transition-all group"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-start space-x-4 flex-1">
                  <span class="text-sm text-primary/60 font-medium min-w-[2rem]">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 class="text-lg font-medium text-primary group-hover:opacity-70 transition-opacity">
                    {faq.data.question}
                  </h3>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-primary/60 group-hover:translate-x-1 transition-transform flex-shrink-0 ml-4"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-secondary/30">
      <div class="container mx-auto px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-light text-primary mb-4">
            Request a Private Consultation
          </h2>
          <p class="text-lg text-primary leading-relaxed max-w-3xl mx-auto mb-12">
            Speak directly with our advisory team for guidance tailored to your situation.
          </p>
        </div>
        <UniversalContactForm client:load />
      </div>
    </section>

    <InternalLinks currentPath="/faqs" title="Explore More Resources" limit={6} />
    <Footer client:load />
  </div>
</Layout>
