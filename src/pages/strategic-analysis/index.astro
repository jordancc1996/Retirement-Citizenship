---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/seo/PageHead.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import Breadcrumbs from '../../components/seo/Breadcrumbs';
import InternalLinks from '../../components/seo/InternalLinks';
import ArticleGrid from '../../components/ArticleGrid';
import { assetUrl } from '../../lib/assetUrl';
import { getCollection } from 'astro:content';
import analysisHero from '../../assets/analysis-hero.jpg';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.jpg', { eager: true });
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split(/[/\\]/).pop() || '';
  imageMap[name] = mod.default;
}

const articles = (await getCollection('articles'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((article) => {
    const filename = article.data.cardImage || article.data.image;
    const img = imageMap[filename];
    if (!img) {
      throw new Error(`Missing hub image: ${filename}`);
    }
    return {
      title: article.data.hubTitle,
      slug: `/strategic-analysis/${article.slug}`,
      excerpt: article.data.excerpt,
      date: article.data.displayDate,
      category: article.data.category as 'jurisdictional-analysis' | 'tax-regulatory' | 'family-governance' | 'market-intelligence',
      categoryLabel: article.data.categoryLabel,
      image: assetUrl(img),
    };
  });
---
<Layout>
  <Fragment slot="head">
    <PageHead
      title="Strategic Analysis — Retirement Citizenship"
      description="Institutional-grade jurisdictional analysis, tax intelligence, and regulatory updates for sophisticated cross-border investors."
      canonical="/strategic-analysis"
    />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header variant="hero" client:load />

    <section
      class="relative min-h-[60vh] flex items-center justify-center bg-cover bg-center bg-no-repeat"
      style={`background-image: url(${assetUrl(analysisHero)})`}
    >
      <div class="absolute inset-0 bg-black/50"></div>
      <div class="absolute top-20 left-0 right-0 z-10">
        <div class="container mx-auto px-8">
          <Breadcrumbs items={[{ name: 'Strategic Analysis', url: '/strategic-analysis' }]} variant="hero" client:load />
        </div>
      </div>
      <div class="container mx-auto px-8 max-w-4xl text-center relative z-10">
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-light mb-6 text-white">
          Strategic Analysis
        </h1>
        <p class="font-sans text-lg md:text-xl text-white/90 leading-relaxed max-w-3xl mx-auto">
          Strategic analysis of golden visa programs for American and Canadian families covers Portugal, Greece, Italy, and second residency planning across 13 jurisdictions.
        </p>
      </div>
    </section>

    <ArticleGrid articles={articles} client:load />

    <section class="py-24 bg-secondary">
      <div class="container mx-auto px-8 max-w-3xl text-center">
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-primary mb-6">
          Begin with a Private Conversation
        </h2>
        <p class="font-sans text-lg text-muted-foreground leading-relaxed mb-10">
          We work with a select number of American families and their advisors each year. Engagements begin with a confidential, no-obligation consultation.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-block px-8 py-4 bg-primary text-primary-foreground font-medium text-sm uppercase tracking-wider rounded-full hover:bg-primary/90 transition-colors"
          >
            Schedule a Private Consultation
          </a>
          <a
            href="/briefing"
            class="inline-block px-8 py-4 border border-primary text-primary font-medium text-sm uppercase tracking-wider rounded-full hover:bg-primary hover:text-primary-foreground transition-colors"
          >
            Request the 2026 Strategic Briefing
          </a>
        </div>
      </div>
    </section>

    <InternalLinks currentPath="/strategic-analysis" title="Explore More" limit={4} />
    <Footer client:load />
  </div>
</Layout>
